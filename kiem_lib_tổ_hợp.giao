# Kiểm lib_tổ_hợp — itertools/combinatorics (ba-trị-aware)
nhập "lib_tổ_hợp.giao"

rọi giai_thừa(5)               # 120
rọi giai_thừa(0)               # 1
rọi giai_thừa(0 - 3)           # ẩn (số âm → không xác định)
rọi số_chỉnh_hợp(5, 2)         # 20
rọi số_tổ_hợp(5, 2)            # 10
rọi số_tổ_hợp(6, 3)            # 20
rọi số_tổ_hợp(5, 9)            # 0 (k>n)
rọi tổ_hợp([1, 2, 3], 2)       # [[1, 2], [1, 3], [2, 3]]
rọi tổ_hợp([1, 2, 3], 0)       # [[]]
rọi chỉnh_hợp([1, 2, 3], 2)    # [[1, 2], [1, 3], [2, 1], [2, 3], [3, 1], [3, 2]]
rọi hoán_vị([1, 2])            # [[1, 2], [2, 1]]
rọi tích_đề([1, 2], [3, 4])    # [[1, 3], [1, 4], [2, 3], [2, 4]]
rọi tập_lũy_thừa([1, 2])       # [[], [1], [2], [1, 2]]
rọi cặp_kề([1, 2, 3, 4])       # [[1, 2], [2, 3], [3, 4]]
