# kiem_ky_kep_giao.giao — builtin kiểm_ký_kép (ML-DSA-65 mldsa-native + Ed25519 Monocypher) trên CẢ HAI máy
#   giao.py → wasm/ky_lenh.wasm · GVM-64 → --preload ky=wasm/ky.wasm   (kiem_gvm64.py so từng ký tự)
# Dữ liệu: khoá DÙNG MỘT LẦN sinh lúc viết bài kiểm (khoá riêng đã bỏ), chữ ký kép trên một thông điệp UTF-8
# có dấu tiếng Việt và emoji, ngữ cảnh "giao-kho-v1".
đặt KE = "6b9abc41949bac16fcc9042cdf7f30c17423fbafd870e50f9abf9fb04620f449"
đặt KM = ""
đặt ND = "mục lục thử: gói_a|1.0|văn|-|-|abc|xin chào 🌊"
đặt NC = "giao-kho-v1"
đặt SE = "6a57c07afb0ba0dbcb84bc9b1fe547fe3e0eb4873c4c11ea24f3e945d8559e204f8153316b74875e04c931f00b9604c8229cef346f4dad2968cb775bde72e000"
đặt SM = ""
rọi "đúng cả hai: " + kiểm_ký_kép(KE, KM, ND, NC, SE, SM)
rọi "sửa nội dung: " + kiểm_ký_kép(KE, KM, ND + ".", NC, SE, SM)
rọi "sai ngữ cảnh: " + kiểm_ký_kép(KE, KM, ND, "giao-kho-v2", SE, SM)
rọi "hỏng riêng Ed25519: " + kiểm_ký_kép(KE, KM, ND, NC, "6a57c07afb0aa0dbcb84bc9b1fe547fe3e0eb4873c4c11ea24f3e945d8559e204f8153316b74875e04c931f00b9604c8229cef346f4dad2968cb775bde72e000", SM)
rọi "hỏng riêng ML-DSA: " + kiểm_ký_kép(KE, KM, ND, NC, SE, "")
rọi "chữ ký ML-DSA cụt: " + kiểm_ký_kép(KE, KM, ND, NC, SE, "00")
đặt r = kiểm_ký_kép("zz", KM, ND, NC, SE, SM)
rọi "khoá không phải hex: " + loại(r)
đặt r2 = kiểm_ký_kép(KE, KM, 5, NC, SE, SM)
rọi "nội dung không phải chuỗi: " + loại(r2)
