đặt KHO_NỀN_CHỮ_KÝ = "kép|992fde01ebad99a4573fb4531e3b7b79b5f184f121fbfc9bcaae9c5ba533e95e03a07796b51c776c75f315457b97a498590ecff3ec769fc09d77e951b591b202|"
đặt KHO_NỀN_KHOÁ_CÔNG = "kép|137d4a2911ebc0b92bdb6898678e73f2cd6f3ca4a7151e69efc223d4b1b7c5ec|"
đặt KHO_NỀN_GÓI = []
gom(KHO_NỀN_GÓI, ["bộ_an_ninh", "# bộ_an_ninh — SIÊU-GÓI: toàn bộ công cụ an ninh phòng thủ (kiểm toán + giám sát + điều tra)\nnói \"━━ bộ_giám_sát ━━\"\nbộ_giám_sát\nnói \"━━ bộ_kiểm_toán ━━\"\nbộ_kiểm_toán\nnói \"━━ bộ_điều_tra ━━\"\nbộ_điều_tra"])
gom(KHO_NỀN_GÓI, ["bộ_giám_sát", "# bộ_giám_sát — SIÊU-GÓI: theo dõi đăng nhập, tiến trình, tài nguyên\nnói \"━━ soi_tiến_trình ━━\"\nsoi_tiến_trình\nnói \"━━ soi_tài_nguyên ━━\"\nsoi_tài_nguyên\nnói \"━━ soi_đăng_nhập ━━\"\nsoi_đăng_nhập"])
gom(KHO_NỀN_GÓI, ["bộ_hệ_thống", "# bộ_hệ_thống — SIÊU-GÓI: tiện ích hệ thống\nnói \"━━ nhật_ký_gọn ━━\"\nnhật_ký_gọn\nnói \"━━ thông_tin_hệ ━━\"\nthông_tin_hệ\nnói \"━━ đo_đĩa ━━\"\nđo_đĩa"])
gom(KHO_NỀN_GÓI, ["bộ_kiểm_toán", "# bộ_kiểm_toán — SIÊU-GÓI: kiểm toán cấu hình, quyền, mật khẩu, kho gói của CHÍNH máy này\nnói \"━━ gác_cổng ━━\"\ngác_cổng\nnói \"━━ kiểm_cấu_hình_hệ ━━\"\nkiểm_cấu_hình_hệ\nnói \"━━ kiểm_kho_gói ━━\"\nkiểm_kho_gói\nnói \"━━ kiểm_sudo ━━\"\nkiểm_sudo\nnói \"━━ soi_lệnh_lạ ━━\"\nsoi_lệnh_lạ\nnói \"━━ soi_người ━━\"\nsoi_người"])
gom(KHO_NỀN_GÓI, ["bộ_tệp", "# bộ_tệp — SIÊU-GÓI: tiện ích tệp và thư mục\nnói \"━━ cây_nhà ━━\"\ncây_nhà\nnói \"━━ dọn_nhà ━━\"\ndọn_nhà"])
gom(KHO_NỀN_GÓI, ["bộ_văn_bản", "# bộ_văn_bản — SIÊU-GÓI: xử lý văn bản\nnói \"━━ tìm_chữ ━━\"\ntìm_chữ\nnói \"━━ đếm_dòng ━━\"\nđếm_dòng"])
gom(KHO_NỀN_GÓI, ["bộ_điều_tra", "# bộ_điều_tra — SIÊU-GÓI: điều tra sự cố: nhật ký, dấu vết, chụp trạng thái\nnói \"━━ dấu_vết ━━\"\ndấu_vết\nnói \"━━ soi_thùng_rác ━━\"\nsoi_thùng_rác"])
gom(KHO_NỀN_GÓI, ["cây_nhà", "# cây_nhà — vẽ cây thư mục nhà của người đang chạy\nnói \"── cây nhà ──\"\ncây /nhà/an"])
gom(KHO_NỀN_GÓI, ["dấu_vết", "# dấu_vết — gom nhanh dấu vết: ai đang chạy, nhật ký gần nhất, tiến trình\nnói \"── ai ──\"\ntôi\nnói \"── nhật ký 30 dòng ──\"\nnhật_ký 30\nnói \"── tiến trình ──\"\ntt"])
gom(KHO_NỀN_GÓI, ["dọn_nhà", "# dọn_nhà — chuyển tệp vào thùng rác (xoá khả hồi — lấy lại bằng hoàn_tác)\nnói \"── dọn ──\"\nxoá $1 && nói \"đã chuyển vào thùng rác: $1\""])
gom(KHO_NỀN_GÓI, ["gác_cổng", "# gác_cổng — soi quyền các tệp nhạy cảm và vì sao người này đọc được hay không\nsoi_người\nnói \"── quyền tệp nhạy cảm ──\"\nnói \"/hệ/mật_khẩu:\"\nsoi /hệ/mật_khẩu\nnói \"/hệ/sudo:\"\nsoi /hệ/sudo\nnói \"/hệ/người_dùng:\"\nsoi /hệ/người_dùng\nnói \"── vì sao (với người đang chạy) ──\"\nvì_sao /hệ/mật_khẩu\nvì_sao /hệ/sudo"])
gom(KHO_NỀN_GÓI, ["kiểm_cấu_hình_hệ", "# kiểm_cấu_hình_hệ — chạy bộ kiểm cú pháp trên mọi tệp cấu hình của /hệ\nnói \"── kiểm cấu hình ──\"\nkiểm_cấu_hình /hệ/người_dùng\nkiểm_cấu_hình /hệ/nhóm\nkiểm_cấu_hình /hệ/sudo\nkiểm_cấu_hình /hệ/mật_khẩu"])
gom(KHO_NỀN_GÓI, ["kiểm_kho_gói", "# kiểm_kho_gói — kho gói có đúng chữ ký kép của khoá đã neo không, đã cài những gì\nnói \"── kho gói (nguồn, chữ ký, khoá đã neo) ──\"\ngói kho\nnói \"── đã cài ──\"\ngói"])
gom(KHO_NỀN_GÓI, ["kiểm_sudo", "# kiểm_sudo — ai được nâng quyền, nâng cho lệnh nào (sổ /hệ/sudo + nhóm)\nnói \"── sổ sudo ──\"\nxem /hệ/sudo\nnói \"── nhóm ──\"\nnhóm"])
gom(KHO_NỀN_GÓI, ["nhật_ký_gọn", "# nhật_ký_gọn — xem 20 dòng nhật ký gần nhất\nnhật_ký 20"])
gom(KHO_NỀN_GÓI, ["soi_lệnh_lạ", "# soi_lệnh_lạ — liệt kê mọi lệnh ở /lệnh và thư mục lệnh riêng để soát lệnh lạ\nnói \"── /lệnh ──\"\nliệt /lệnh\nnói \"── lệnh riêng ──\"\nliệt /nhà/an/lệnh"])
gom(KHO_NỀN_GÓI, ["soi_người", "# soi_người — liệt kê người dùng và nhóm trên máy\nnói \"── người ──\"\nngười\nnói \"── nhóm ──\"\nnhóm"])
gom(KHO_NỀN_GÓI, ["soi_thùng_rác", "# soi_thùng_rác — xem thùng rác: thứ gì đã bị xoá (xoá trong HĐH-GIAO là khả hồi)\nnói \"── thùng rác ──\"\nthùng"])
gom(KHO_NỀN_GÓI, ["soi_tiến_trình", "# soi_tiến_trình — liệt kê tiến trình đang chạy và chủ của chúng\nnói \"── tiến trình ──\"\ntt"])
gom(KHO_NỀN_GÓI, ["soi_tài_nguyên", "# soi_tài_nguyên — bộ nhớ và tiến trình — dấu hiệu bị chiếm tài nguyên\nnói \"── bộ nhớ ──\"\nbộ_nhớ\nsoi_tiến_trình"])
gom(KHO_NỀN_GÓI, ["soi_đăng_nhập", "# soi_đăng_nhập — lọc nhật ký tìm đăng nhập, đăng nhập sai, nâng quyền\nnói \"── đăng nhập trong nhật ký ──\"\nnhật_ký 200 | tìm đăng\nnói \"── nâng quyền ──\"\nnhật_ký 200 | tìm duyệt"])
gom(KHO_NỀN_GÓI, ["thông_tin_hệ", "# thông_tin_hệ — tóm tắt máy: ai, ở đâu, tiến trình, bộ nhớ\nnói \"── thông tin hệ ──\"\ntôi\nở\ntt\nbộ_nhớ"])
gom(KHO_NỀN_GÓI, ["tìm_chữ", "# tìm_chữ — tìm các dòng chứa một chữ trong tệp: tìm_chữ <chữ> <tệp>\nxem $2 | tìm $1"])
gom(KHO_NỀN_GÓI, ["đo_đĩa", "# đo_đĩa — đếm số tệp trong một thư mục (mặc định /tạm)\nnói \"── đếm tệp ──\"\nliệt $1 | đếm"])
gom(KHO_NỀN_GÓI, ["đếm_dòng", "# đếm_dòng — đếm dòng/từ của một tệp\nxem $1 | đếm"])
hàm dựng_kho_nền(M, khởi) {
    gọi(M, khởi, GH_TẠO_THƯ, ["/hệ/kho", 755])
    gọi(M, khởi, GH_TẠO_THƯ, ["/hệ/kho/gói", 755])
    lặp g trong KHO_NỀN_GÓI { gọi(M, khởi, GH_TẠO, ["/hệ/kho/gói/" + g[0], 644, g[1]]) }
    gọi(M, khởi, GH_TẠO, ["/hệ/kho/mục_lục", 644, KHO_NỀN_MỤC_LỤC])
    # NEO TIN CẬY — nguồn khai đúng một khoá công của riêng nó (học `Signed-By:`)
    gọi(M, khởi, GH_TẠO, ["/hệ/kho/khoá_công", 644, KHO_NỀN_KHOÁ_CÔNG])
    gọi(M, khởi, GH_TẠO, ["/hệ/kho/mục_lục.ký", 644, KHO_NỀN_CHỮ_KÝ])
    gọi(M, khởi, GH_TẠO, ["/hệ/kho/nguồn", 644, "kho-nhà|/hệ/kho/mục_lục|/hệ/kho/mục_lục.ký|/hệ/kho/khoá_công"])
    gọi(M, khởi, GH_TẠO, ["/hệ/gói_đã_cài", 644, ""])
}
