# Kiểm lib_ngày — Date math (ba-trị-aware), thuần toán
nhập "lib_ngày.giao"

rọi năm_nhuận(2000)              # sáng
rọi năm_nhuận(1900)             # tối
rọi năm_nhuận(2024)             # sáng
rọi năm_nhuận(2023)             # tối
rọi ngày_trong_tháng(2024, 2)   # 29
rọi ngày_trong_tháng(2023, 2)   # 28
rọi ngày_trong_tháng(2024, 4)   # 30
rọi hợp_lệ(2024, 2, 29)         # sáng
rọi hợp_lệ(2023, 2, 29)         # tối
rọi hợp_lệ(2024, 13, 1)         # tối
rọi thứ(2000, 1, 1)             # Thứ Bảy
rọi thứ(2024, 1, 1)             # Thứ Hai
rọi thứ(2024, 6, 17)            # Thứ Hai
rọi khoảng_ngày(2024, 1, 1, 2024, 12, 31)  # 365
rọi khoảng_ngày(2024, 2, 28, 2024, 3, 1)   # 2  (qua 29/2)
rọi cộng_ngày(2024, 2, 28, 1)   # [2024,2,29]
rọi cộng_ngày(2024, 12, 31, 1)  # [2025,1,1]
rọi định_dạng(2024, 3, 5)       # 2024-03-05
rọi số_ngày(2024, 13, 40)       # ẩn (ngày sai → KHÔNG bịa)
rọi thứ(2024, 2, 30)            # ẩn
